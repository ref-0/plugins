#!/bin/sh
# Runs ref0 for the hooks and commands of its plugin.
REF0_PLUGIN_VERSION='0.6.0'
export REF0_PLUGIN_VERSION
candidate=$(command -v ref0 2>/dev/null || :)
if [ -n "$candidate" ]; then exec "$candidate" "$@"; fi
if [ -x "$HOME/.ref0/bin/ref0" ]; then exec "$HOME/.ref0/bin/ref0" "$@"; fi
printf '%s\n' 'run npm i -g @ref0/cli, then ref0 connect --harness <claude-code or codex>' >&2
exit 127
